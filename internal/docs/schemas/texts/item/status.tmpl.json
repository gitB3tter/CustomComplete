{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "/docs/schemas/texts/item/status",
    "type": "object",
    "required": [
        "status",
        "message"
    ],
    "additionalProperties": false,
    "properties": {
        "status": {
            "type": "string",
            "enum": [
                "pending",
                "processing",
                "completed",
                "failed"
            ]
        },
        "message": {
            "type": "string",
            "examples": [
                "{{T `TextStatusPending`}}",
                "{{T `TextStatusProcessing`}}",
                "{{T `TextStatusComplete`}}",
                "{{T `TextStatusFailed`}}"
            ]
        },
        "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
        },
        "stage": {
            "type": "string",
            "examples": [
                "{{T `ProcessingReadingText`}}",
                "{{T `ProcessingCounting`}}",
                "{{T `ProcessingPreparingSuggestions`}}",
                "{{T `ProcessingSavingSuggestions`}}"
            ]
        }
    }
}