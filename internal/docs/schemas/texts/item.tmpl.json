{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "/docs/schemas/texts/item",
    "type": "object",
    "required": [
        "name",
        "figitlename",
        "filesize",
        "filehash"
    ],
    "additionalProperties": false,
    "properties": {
        "name": {
            "title": "{{T `TextFieldName`}}",
            "description": "{{T `TextFieldNameHint` .NameMaxCodePoints}}",
            "type": "string",
            "minLength": 1,
            "maxLength": {{.NameMaxCodePoints}},
            "pattern": "\\S"
        },
        "filename": {
            "type": "string",
            "minLength": 5,
            "maxLength": 50,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "filesize": {
            "type": "integer",
            "minimum": 3,
            "maximum": 10000000,
            "readOnly": true
        },
        "filehash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "readOnly": true
        }
    }
}