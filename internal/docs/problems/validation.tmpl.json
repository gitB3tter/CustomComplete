{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/docs/problems/validation",
  "title": "{{T `DocsProblemValidationTitle`}}",
  "description": "{{T `DocsProblemValidationDescription`}}",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "/docs/problems/validation"
    },
    "title": {
      "type": "string",
      "description": "{{T `DocsProblemTitleDescription`}}"
    },
    "detail": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "description": "{{T `DocsProblemInvalidParamsDescription`}}",
      "items": {
        "$ref": "/docs/problems/extensions/errors"
      }
    }
  },
  "required": [
    "type",
    "title",
    "errors"
  ],
  "additionalProperties": true
}