{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "/docs/problems/extensions/errors",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "{{T `DocsProblemInvalidParamNameDescription`}}"
        },
        "code": {
            "type": "string",
            "description": "{{T `DocsProblemInvalidParamCodeDescription`}}",
            "enum": [
                "required",
                "pattern",
                "minBytes",
                "maxBytes",
                "minCodePoints",
                "maxCodePoints",
                "minWords",
                "maxWords",
                "readOnly",
                "additionalProperties",
                "type",
                "invalid",
                "notFound",
                "conflict",
                "enum"
            ]
        },
        "params": {
            "type": "object",
            "description": "{{T `DocsProblemInvalidParamParamsDescription`}}",
            "additionalProperties": false,
            "properties": {
                "limit": {
                    "type": "integer",
                    "minimum": 0
                },
                "actual": {
                    "type": ["integer", "string"],
                    "minimum": 0
                },
                "expected": {
                    "type": ["string", "array"]
                },
                "pattern": {
                    "type": "string",
                    "format": "regex"
                },
                "canonical": {
                    "type": "string"
                },
                "rule": {
                    "type": "string",
                    "enum": [
                        "notBlank",
                        "reserved"
                    ]
                },
                "encoding": {
                    "type": "string",
                    "enum": [
                        "utf-8"
                    ]
                }
            }
        },
        "reason": {
            "type": "string",
            "description": "{{T `DocsProblemInvalidParamReasonDescription`}}"
        }
    },
    "required": [
        "name",
        "code",
        "reason"
    ],
    "additionalProperties": false
}